# Copia este archivo a ".env" (sin ".example") y pega tu clave real ahi.
# ".env" esta en .gitignore -- nunca se sube a ningun lado ni se comparte.
FISCAL_AI_API_KEY=

# SEC EDGAR es publico y gratis (no hace falta API key), pero exige un header
# User-Agent que identifique quien llama -- sin esto devuelve 403. Pone tu
# nombre/app + un email de contacto, por ejemplo:
SEC_EDGAR_USER_AGENT=

# Ruta al archivo JSON de la service account de Google (ver README para como
# generarlo). El archivo NUNCA se sube a git -- guardalo en credentials/,
# que esta en .gitignore.
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# ID del Google Sheet donde se escribe el resultado (lo ves en la URL:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit). Si preferis un
# Sheet por empresa en vez de pestanas por empresa en un solo Sheet, dejalo
# vacio aca y pasalo por parametro al script.
GOOGLE_SHEET_ID=
