# Copia este archivo a ".env" (sin ".example") y pega tu clave real ahi.
# ".env" esta en .gitignore -- nunca se sube a ningun lado ni se comparte.
FISCAL_AI_API_KEY=

# SEC EDGAR es publico y gratis (no hace falta API key), pero exige un header
# User-Agent que identifique quien llama -- sin esto devuelve 403. Pone tu
# nombre/app + un email de contacto, por ejemplo:
SEC_EDGAR_USER_AGENT=
